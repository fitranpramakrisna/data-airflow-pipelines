{"timestamp":"2026-03-26T08:04:52.722046Z","level":"info","event":"Executing: TRUNCATE TABLE fact_researchview.t_performance_highlights;\n\nINSERT INTO fact_researchview.t_performance_highlights (year, affiliation_id, nama_pt, total_publications, total_citasi)\nWITH summary (\n    year,\n    affiliation_id,\n    nama_pt,\n    total_publications,\n    total_citasi\n) AS (\n    SELECT\n        LEFT(tds.tgl_terbit_scopus, 4),\n        tds.affiliation_id,\n        MAX(tps.nama_pt),\n        COUNT(tds.eid_scopus),\n        SUM(tds.cited_by_scopus)\n    FROM db_scopus.t_document_scopus tds\n    JOIN db_scopus.t_pt_scopus tps\n        ON tps.affiliation_id = tds.affiliation_id\n    WHERE tds.tgl_terbit_scopus >= '2014-01-01'\n    GROUP BY 1, 2\n)\nSELECT\n    year,\n    affiliation_id,\n    nama_pt,\n    total_publications,\n    total_citasi\nFROM summary","logger":"airflow.task.operators.airflow.providers.common.sql.operators.sql.SQLExecuteQueryOperator","filename":"sql.py","lineno":394}
