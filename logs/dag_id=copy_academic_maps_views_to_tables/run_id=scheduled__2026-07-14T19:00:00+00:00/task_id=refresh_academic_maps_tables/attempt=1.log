{"timestamp":"2026-08-10T10:29:26.160694Z","level":"info","event":"Executing: ['DELETE FROM ranking.t_academic_map_publication_author', 'DELETE FROM ranking.t_academic_map_publication_sdg', 'DELETE FROM ranking.t_academic_map_publication', 'DELETE FROM ranking.t_academic_map_master_author', 'DELETE FROM ranking.t_academic_map_master_affiliation', '\\n                INSERT INTO ranking.t_academic_map_master_affiliation\\n                    (\\n    affiliation_id,\\n    affiliation_name,\\n    country_code,\\n    affiliation_country,\\n    city_code,\\n    affiliation_city\\n)\\n                SELECT \\n    affiliation_id,\\n    affiliation_name,\\n    country_code,\\n    affiliation_country,\\n    city_code,\\n    affiliation_city\\n\\n                FROM ranking.vt_academicMaps_masterAffiliation\\n            ', 'SET @academic_maps_original_sql_mode = @@SESSION.sql_mode', \"\\n                SET SESSION sql_mode = TRIM(BOTH ',' FROM\\n                    REPLACE(\\n                        REPLACE(\\n                            REPLACE(@@SESSION.sql_mode,\\n                                'STRICT_TRANS_TABLES', ''),\\n                            'STRICT_ALL_TABLES', ''),\\n                        ',,', ','\\n                    )\\n                )\\n            \", \"\\n                INSERT INTO ranking.t_academic_map_master_author\\n                    (\\n    id_author,\\n    author_preferredName,\\n    author_firstName,\\n    author_lastName,\\n    author_orcid,\\n    author_hindex,\\n    author_fwciscore\\n)\\n                SELECT \\n    id_author,\\n    author_preferredName,\\n    author_firstName,\\n    author_lastName,\\n    author_orcid,\\n    NULLIF(TRIM(CAST(author_hindex AS CHAR)), '') AS author_hindex,\\n    NULLIF(TRIM(CAST(author_fwciscore AS CHAR)), '') AS author_fwciscore\\n\\n                FROM ranking.vt_academicMaps_masterAuthor\\n            \", 'SET SESSION sql_mode = @academic_maps_original_sql_mode', '\\n                INSERT INTO ranking.t_academic_map_publication\\n                    (\\n    eid,\\n    id_scopus,\\n    year,\\n    date,\\n    fwci_scopus,\\n    cited_by\\n)\\n                SELECT \\n    eid,\\n    id_scopus,\\n    year,\\n    date,\\n    fwci_scopus,\\n    cited_by\\n\\n                FROM (\\n                    SELECT\\n                        \\n    eid,\\n    id_scopus,\\n    year,\\n    date,\\n    fwci_scopus,\\n    cited_by\\n,\\n                        ROW_NUMBER() OVER (\\n                            PARTITION BY eid\\n                            ORDER BY\\n                                date DESC,\\n                                cited_by DESC,\\n                                fwci_scopus DESC,\\n                                id_scopus DESC\\n                        ) AS row_num\\n                    FROM ranking.vt_academicMaps_publication\\n                ) AS deduplicated_publication\\n                WHERE row_num = 1\\n            ', '\\n                INSERT INTO ranking.t_academic_map_publication_author\\n                    (\\n    eid_scopus,\\n    id_author,\\n    author_sequenced,\\n    affiliation_id\\n)\\n                SELECT \\n    eid_scopus,\\n    id_author,\\n    author_sequenced,\\n    affiliation_id\\n\\n                FROM ranking.vt_academicMaps_publicationAuthor\\n            ', '\\n                INSERT INTO ranking.t_academic_map_publication_sdg\\n                    (\\n    eid,\\n    asjc_category,\\n    subject_area,\\n    faculty_area\\n)\\n                SELECT \\n    eid,\\n    asjc_category,\\n    subject_area,\\n    faculty_area\\n\\n                FROM ranking.vt_academicMaps_publicationSDG\\n            ']","run_id":"scheduled__2026-07-14T19:00:00+00:00","task_id":"refresh_academic_maps_tables","map_index":-1,"try_number":1,"dag_id":"copy_academic_maps_views_to_tables","ti_id":"019feb37-a74a-72ca-b1d4-99666d85d811","logger":"airflow.task.operators.airflow.providers.common.sql.operators.sql.SQLExecuteQueryOperator