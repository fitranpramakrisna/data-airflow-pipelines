"""DAG domain ranking untuk membangun fact Research View dari file SQL."""

from airflow import DAG
from airflow.providers.common.sql.operators.sql import SQLExecuteQueryOperator
from airflow.operators.empty import EmptyOperator
from datetime import datetime

default_args = {
    "owner": "airflow",
    "start_date": datetime(2025, 1, 1),
    "retries": 1,
}

with DAG(
    dag_id="fact_researchview_dag_v2",
    default_args=default_args,
    template_searchpath=["/opt/airflow/scripts/ranking/sql"],
    schedule="0 2 * * 6",
    catchup=False,
) as dag:

    start_task = EmptyOperator(
        task_id="start_task"
    )

    t_performance_highlights = SQLExecuteQueryOperator(
        task_id="t_performance_highlights_update",
        conn_id="fact_researchview",
        sql="t_performance_highlights.sql",
    )

    end_task = EmptyOperator(
        task_id="end_task"
    )

    start_task >> t_performance_highlights >> end_task
